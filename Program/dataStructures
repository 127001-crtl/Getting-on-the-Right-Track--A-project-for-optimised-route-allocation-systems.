class Route:
    def __init__(self, vehicle):
        self.Vehicle = vehicle
        self.Stops = []                  # ordered list of Delivery objects
        self.TotalLoad = 0               # sum of demands for all deliveries in the route
        self.TotalDistance = 0.0        # total travel distance for the route
        self.TotalDuration = 0.0         # total route time including travel/service time

    def add_stop(self, delivery):
        self.Stops.append(delivery)
        self.TotalLoad += delivery.Demand

    def set_totals(self, distance, duration):
        self.TotalDistance = distance
        self.TotalDuration = duration

    def __len__(self):
        return len(self.Stops)

    def __repr__(self):
        return (
            f"Route(VehicleID={self.Vehicle.VehicleID}, "
            f"Stops={len(self.Stops)}, TotalLoad={self.TotalLoad}, "
            f"TotalDistance={self.TotalDistance}, TotalDuration={self.TotalDuration})"
        )